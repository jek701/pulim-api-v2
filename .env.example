# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

FIREBASE_PROJECT_ID=
# Optional. Leave empty for the default Firestore database `(default)`.
FIRESTORE_DATABASE_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
TELEGRAM_BOT_TOKEN=
DEBUG_TELEGRAM_AUTH=false

OPENAI_API_KEY=
AI_MODEL_FREE=gpt-5.4-mini
AI_MODEL_PREMIUM=gpt-5.6-terra
AI_MODEL_FORECAST=gpt-5.4-mini

AI_RATE_LIMIT_PER_MIN=20
AI_MAX_HISTORY_MESSAGES=12
AI_MAX_OUTPUT_TOKENS_FREE=1600
AI_MAX_OUTPUT_TOKENS_PREMIUM=6000
AI_MAX_OUTPUT_TOKENS_FORECAST=3000
AI_PREMIUM_MESSAGES_PER_PERIOD=500

# HMAC shared only with pulim-payment-api. Generate with: openssl rand -base64 48
# The main API stays available without it, but billing event delivery returns 503.
PULIM_PAYMENT_INTERNAL_SECRET=
