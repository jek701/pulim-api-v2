# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

FIREBASE_PROJECT_ID=
# Optional. Leave empty for the default Firestore database `(default)`.
FIRESTORE_DATABASE_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
TELEGRAM_BOT_TOKEN=
DEBUG_TELEGRAM_AUTH=false

# Telegram Premium quick entry. Generate the webhook secret with `openssl rand -hex 24`.
TELEGRAM_QUICK_ENTRY_ENABLED=false
# Public URL of this API. Registered with Telegram automatically at API startup.
TELEGRAM_WEBHOOK_URL=https://api.m-pulim.uz/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_DEFAULT_TIMEZONE=Asia/Tashkent
TELEGRAM_PARSE_MODEL=gpt-5.4-mini
TELEGRAM_PARSE_MODEL_ESCALATION=gpt-5.6-terra
TELEGRAM_PARSE_MAX_OUTPUT_TOKENS=2500
TELEGRAM_PARSE_TIMEOUT_MS=20000
TELEGRAM_PARSE_DAILY_LIMIT=100
TELEGRAM_PARSE_PER_MINUTE_LIMIT=10
TELEGRAM_DRAFT_TTL_HOURS=24
TELEGRAM_MAX_ITEMS_PER_MESSAGE=10
TELEGRAM_MAX_MESSAGE_CHARS=1000
TELEGRAM_FX_RETRY_INTERVAL_MS=60000
TELEGRAM_FX_RETRY_BATCH_SIZE=20
TELEGRAM_FX_MAX_RETRY_HOURS=168
WEB_APP_URL=https://m-pulim.uz
PREMIUM_CHECKOUT_URL=

OPENAI_API_KEY=
AI_MODEL_FREE=gpt-5.4-mini
AI_MODEL_PREMIUM=gpt-5.6-terra
AI_MODEL_FORECAST=gpt-5.4-mini

AI_RATE_LIMIT_PER_MIN=20
AI_MAX_HISTORY_MESSAGES=12
AI_MAX_OUTPUT_TOKENS_FREE=1600
AI_MAX_OUTPUT_TOKENS_PREMIUM=6000
AI_MAX_OUTPUT_TOKENS_FORECAST=3000
AI_PREMIUM_MESSAGES_PER_PERIOD=500

# HMAC shared only with pulim-payment-api. Generate with: openssl rand -base64 48
# The main API stays available without it, but billing event delivery returns 503.
PULIM_PAYMENT_INTERNAL_SECRET=
